// Client and server talk to each other in memory: full handshakes with
// real certificate checks, application data both ways, key update,
// exporters, resumption, mutual TLS, HelloRetryRequest, and the failures
// a wrong name, an unknown CA, a wrong pin or a missing client cert cause.
// Server certificates: Ed25519, ECDSA P-256 (with an intermediate), RSA-2048
// and ECDSA P-384.

import "std/io";
import "std/mem";
import "mtls/mtls";

// Bytes in flight in each direction; a side may take only part of what
// is waiting while it holds unread application data.
var g_ab: uint8[262144];
var g_ablen: int64 = 0;
var g_ba: uint8[262144];
var g_balen: int64 = 0;

fn move(from: MtlsConn*, to: MtlsConn*, buf: uint8*, len: int64*) -> bool {
  var n: int64 = mtls_conn_take_out(from, buf + *len, 262144 - *len);
  *len = *len + n;
  if (*len == 0) { return n > 0; }
  var k: int64 = mtls_conn_feed(to, buf, *len);
  if (k <= 0) { return n > 0; }
  memmove(buf, buf + k, *len - k);
  *len = *len - k;
  return true;
}

// Moves bytes both ways until nothing moves.
fn pump(a: MtlsConn*, b: MtlsConn*) -> int32 {
  for round in 0..1000 {
    var m1: bool = move(a, b, &g_ab[0], &g_ablen);
    var m2: bool = move(b, a, &g_ba[0], &g_balen);
    if (!m1 && !m2) { return 0; }
  }
  return 1;
}

fn handshake_host(ccfg: MtlsConfig*, scfg: MtlsConfig*, host: string, cp: MtlsConn**, sp: MtlsConn**) -> int32 {
  g_ablen = 0;
  g_balen = 0;
  var c: MtlsConn* = mtls_client_new(ccfg);
  var s: MtlsConn* = mtls_server_new(scfg);
  *cp = c;
  *sp = s;
  if (mtls_client_start(c, host) != MTLS_OK) { return 1; }
  pump(c, s);
  if (mtls_conn_handshaking(c) || mtls_conn_handshaking(s)) { return 2; }
  if (mtls_conn_error(c) != 0 || mtls_conn_error(s) != 0) { return 3; }
  return 0;
}

fn handshake(ccfg: MtlsConfig*, scfg: MtlsConfig*, cp: MtlsConn**, sp: MtlsConn**) -> int32 {
  return handshake_host(ccfg, scfg, "server.test", cp, sp);
}

fn echo_check(c: MtlsConn*, s: MtlsConn*) -> int32 {
  var msg: string = "ping over tls";
  if (mtls_conn_write(c, msg.chars, (int64)msg.length) != (int64)msg.length) { return 1; }
  pump(c, s);
  var got: uint8[64];
  var n: int64 = mtls_conn_read(s, &got[0], 64);
  if (n != (int64)msg.length || memcmp(&got[0], msg.chars, n) != 0) { return 2; }
  // A large write spans several records.
  var big: uint8[50000];
  for i in 0..50000 { big[i] = (uint8)(i * 7); }
  if (mtls_conn_write(s, &big[0], 50000) != 50000) { return 3; }
  pump(c, s);
  var back: uint8[50000];
  var total: int64 = 0;
  while (total < 50000) {
    var k: int64 = mtls_conn_read(c, &back[total], 50000 - total);
    if (k <= 0) { return 4; }
    total = total + k;
    pump(c, s);
  }
  if (memcmp(&big[0], &back[0], 50000) != 0) { return 5; }
  return 0;
}

fn server_cfg(cfg: MtlsConfig*, chain: string, key: string) -> int32 {
  mtls_config_init(cfg);
  if (mtls_config_set_cert_pem(cfg, chain.chars, (int64)chain.length, key.chars, (int64)key.length) != MTLS_OK) { return 1; }
  mtls_config_add_alpn(cfg, "h2");
  mtls_config_add_alpn(cfg, "http/1.1");
  return 0;
}

// One full run at a protocol version against a server certificate.
fn scenario(v: int32, want_suite: int32, chain: string, key: string, root: string) -> int32 {
  var ca_pem: string = import_str "data/tls/ca.pem";
  var ccert: string = import_str "data/tls/client.pem";
  var ckey: string = import_str "data/tls/client.key";
  var scfg: MtlsConfig;
  if (server_cfg(&scfg, chain, key) != 0) { return 1; }
  var roots: MtlsRoots;
  mtls_roots_init(&roots);
  if (mtls_roots_add_pem(&roots, root.chars, (int64)root.length) != 1) { return 2; }
  var ccfg: MtlsConfig;
  mtls_config_init(&ccfg);
  ccfg.max_version = v;
  ccfg.roots = &roots;
  mtls_config_add_alpn(&ccfg, "http/1.1");
  var cache: MtlsSessionCache* = mtls_cache_new();
  ccfg.cache = cache;

  var c: MtlsConn* = (MtlsConn*)0;
  var s: MtlsConn* = (MtlsConn*)0;
  var rc: int32 = handshake(&ccfg, &scfg, &c, &s);
  if (rc != 0) { return 10 + rc; }
  if (mtls_conn_version(c) != v || mtls_conn_version(s) != v || mtls_conn_suite(c) != want_suite) { return 20; }
  if (mtls_conn_alpn(c) != "http/1.1" || mtls_conn_alpn(s) != "http/1.1") { return 21; }
  if (mtls_conn_server_name(s) != "server.test" || !mtls_conn_peer_verified(c)) { return 22; }
  rc = echo_check(c, s);
  if (rc != 0) { return 30 + rc; }
  if (v == MTLS_TLS13) {
    if (mtls_conn_key_update(c, true) != MTLS_OK) { return 40; }
    pump(c, s);
    rc = echo_check(c, s);
    if (rc != 0) { return 40 + rc; }
    var e1: uint8[32];
    var e2: uint8[32];
    mtls_conn_export(c, "EXPORTER-test", (uint8*)0, 0, &e1[0], 32);
    mtls_conn_export(s, "EXPORTER-test", (uint8*)0, 0, &e2[0], 32);
    if (memcmp(&e1[0], &e2[0], 32) != 0) { return 48; }
  }
  mtls_conn_close(c);
  pump(c, s);
  var tmp: uint8[8];
  if (mtls_conn_read(s, &tmp[0], 8) != 0) { return 50; }
  mtls_conn_free(c);
  mtls_conn_free(s);

  // Resumption with the ticket from the first connection.
  var c2: MtlsConn* = (MtlsConn*)0;
  var s2: MtlsConn* = (MtlsConn*)0;
  rc = handshake(&ccfg, &scfg, &c2, &s2);
  if (rc != 0) { return 60 + rc; }
  if (!mtls_conn_resumed(c2) || !mtls_conn_resumed(s2)) { return 70; }
  rc = echo_check(c2, s2);
  if (rc != 0) { return 70 + rc; }
  mtls_conn_free(c2);
  mtls_conn_free(s2);

  // Mutual TLS: the server checks the client against the Ed25519 CA.
  var croots: MtlsRoots;
  mtls_roots_init(&croots);
  mtls_roots_add_pem(&croots, ca_pem.chars, (int64)ca_pem.length);
  scfg.client_auth = MTLS_CLIENT_AUTH_REQUIRE;
  scfg.roots = &croots;
  if (mtls_config_set_cert_pem(&ccfg, ccert.chars, (int64)ccert.length, ckey.chars, (int64)ckey.length) != MTLS_OK) { return 79; }
  ccfg.cache = (MtlsSessionCache*)0;
  var c3: MtlsConn* = (MtlsConn*)0;
  var s3: MtlsConn* = (MtlsConn*)0;
  rc = handshake(&ccfg, &scfg, &c3, &s3);
  if (rc != 0) { return 80 + rc; }
  if (mtls_conn_peer_cert_count(s3) != 1 || !mtls_conn_peer_verified(s3)) { return 90; }
  rc = echo_check(c3, s3);
  if (rc != 0) { return 90 + rc; }
  mtls_conn_free(c3);
  mtls_conn_free(s3);

  // No client certificate where one is required.
  mtls_config_free(&ccfg);
  var c4: MtlsConn* = (MtlsConn*)0;
  var s4: MtlsConn* = (MtlsConn*)0;
  rc = handshake(&ccfg, &scfg, &c4, &s4);
  if (rc == 0) { return 100; }
  var want_alert: int32 = MTLS_ALERT_CERTIFICATE_REQUIRED;
  if (v == MTLS_TLS12) { want_alert = MTLS_ALERT_HANDSHAKE_FAILURE; }
  if (mtls_conn_alert_sent(s4) != want_alert) { return 101; }
  mtls_conn_free(c4);
  mtls_conn_free(s4);
  mtls_cache_free(cache);
  mtls_config_free(&scfg);
  mtls_roots_free(&roots);
  mtls_roots_free(&croots);
  return 0;
}

// Handshakes that must fail, and the HelloRetryRequest path.
fn edge_cases() -> int32 {
  var chain: string = import_str "data/tls/ecserver-chain.pem";
  var key: string = import_str "data/tls/ecserver.key";
  var ecroot: string = import_str "data/tls/ecroot.pem";
  var edca: string = import_str "data/tls/ca.pem";
  var scfg: MtlsConfig;
  if (server_cfg(&scfg, chain, key) != 0) { return 1; }
  var roots: MtlsRoots;
  mtls_roots_init(&roots);
  mtls_roots_add_pem(&roots, ecroot.chars, (int64)ecroot.length);
  var ccfg: MtlsConfig;
  mtls_config_init(&ccfg);
  ccfg.roots = &roots;
  var c: MtlsConn* = (MtlsConn*)0;
  var s: MtlsConn* = (MtlsConn*)0;

  // Wildcard name: *.server.test covers a.server.test.
  if (handshake_host(&ccfg, &scfg, "a.server.test", &c, &s) != 0) { return 2; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  // Wrong name.
  if (handshake_host(&ccfg, &scfg, "other.test", &c, &s) == 0) { return 3; }
  if (mtls_conn_cert_error(c) != MTLS_CV_NAME_MISMATCH || mtls_conn_alert_received(s) != MTLS_ALERT_BAD_CERTIFICATE) {
    println("detail {mtls_conn_cert_error(c)} alert {mtls_conn_alert_received(s)} {mtls_conn_alert_sent(c)}");
    return 4;
  }
  mtls_conn_free(c);
  mtls_conn_free(s);
  // A CA we do not trust.
  var other: MtlsRoots;
  mtls_roots_init(&other);
  mtls_roots_add_pem(&other, edca.chars, (int64)edca.length);
  ccfg.roots = &other;
  if (handshake(&ccfg, &scfg, &c, &s) == 0) { return 5; }
  if (mtls_conn_alert_received(s) != MTLS_ALERT_UNKNOWN_CA) { return 6; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  ccfg.roots = &roots;
  // Pinned key: only the leaf's public key matters.
  var leaf: MtlsCert;
  if (mtls_cert_parse(&leaf, scfg.chain[0].p, scfg.chain[0].n) != MTLS_OK) { return 7; }
  ccfg.verify_mode = MTLS_VERIFY_PIN;
  mtls_cert_spki_sha256(&leaf, &ccfg.pin[0]);
  if (handshake_host(&ccfg, &scfg, "", &c, &s) != 0) { return 8; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  ccfg.pin[0] = ccfg.pin[0] ^ (uint8)1;
  if (handshake(&ccfg, &scfg, &c, &s) == 0) { return 9; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  ccfg.verify_mode = MTLS_VERIFY_FULL;
  // Full verification refuses to start without a host name.
  c = mtls_client_new(&ccfg);
  if (mtls_client_start(c, "") != MTLS_E_ARG) { return 10; }
  mtls_conn_free(c);
  // HelloRetryRequest: the client's first share is X25519, the server
  // only takes P-256.
  scfg.groups[0] = MTLS_GROUP_SECP256R1;
  scfg.ngroups = 1;
  if (handshake(&ccfg, &scfg, &c, &s) != 0) { return 11; }
  if (!c->hrr_done || c->group != MTLS_GROUP_SECP256R1) { return 12; }
  if (echo_check(c, s) != 0) { return 13; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  // P-384 key exchange, both versions.
  ccfg.groups[0] = MTLS_GROUP_SECP384R1;
  ccfg.ngroups = 1;
  scfg.groups[0] = MTLS_GROUP_SECP384R1;
  if (handshake(&ccfg, &scfg, &c, &s) != 0) { return 16; }
  if (c->group != MTLS_GROUP_SECP384R1 || echo_check(c, s) != 0) { return 17; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  ccfg.max_version = MTLS_TLS12;
  if (handshake(&ccfg, &scfg, &c, &s) != 0) { return 18; }
  if (c->group != MTLS_GROUP_SECP384R1) { return 19; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  ccfg.max_version = MTLS_TLS13;
  ccfg.groups[0] = MTLS_GROUP_X25519;
  ccfg.groups[1] = MTLS_GROUP_SECP256R1;
  ccfg.ngroups = 2;
  scfg.groups[0] = MTLS_GROUP_SECP256R1;
  // TLS 1.2 with P-256 ECDHE.
  ccfg.max_version = MTLS_TLS12;
  if (handshake(&ccfg, &scfg, &c, &s) != 0) { return 14; }
  if (c->group != MTLS_GROUP_SECP256R1) { return 15; }
  mtls_conn_free(c);
  mtls_conn_free(s);
  mtls_config_free(&scfg);
  mtls_roots_free(&roots);
  mtls_roots_free(&other);
  return 0;
}

fn main() -> int32 {
  var ed_chain: string = import_str "data/tls/server.pem";
  var ed_key: string = import_str "data/tls/server.key";
  var ed_root: string = import_str "data/tls/ca.pem";
  var ec_chain: string = import_str "data/tls/ecserver-chain.pem";
  var ec_key: string = import_str "data/tls/ecserver.key";
  var ec_root: string = import_str "data/tls/ecroot.pem";
  var rc: int32 = scenario(MTLS_TLS13, 0x1301, ed_chain, ed_key, ed_root);
  if (rc != 0) { println("TLS 1.3 Ed25519 failed at {rc}"); return 1; }
  rc = scenario(MTLS_TLS12, 0xc02b, ed_chain, ed_key, ed_root);
  if (rc != 0) { println("TLS 1.2 Ed25519 failed at {rc}"); return 2; }
  rc = scenario(MTLS_TLS13, 0x1301, ec_chain, ec_key, ec_root);
  if (rc != 0) { println("TLS 1.3 P-256 failed at {rc}"); return 3; }
  rc = scenario(MTLS_TLS12, 0xc02b, ec_chain, ec_key, ec_root);
  if (rc != 0) { println("TLS 1.2 P-256 failed at {rc}"); return 4; }
  var rsa_chain: string = import_str "data/tls/rsaserver.pem";
  var rsa_key: string = import_str "data/tls/rsaserver.key";
  var rsa_root: string = import_str "data/tls/rsaroot.pem";
  var p384_chain: string = import_str "data/tls/p384server.pem";
  var p384_key: string = import_str "data/tls/p384server.key";
  var p384_root: string = import_str "data/tls/p384root.pem";
  rc = scenario(MTLS_TLS13, 0x1301, rsa_chain, rsa_key, rsa_root);
  if (rc != 0) { println("TLS 1.3 RSA failed at {rc}"); return 6; }
  rc = scenario(MTLS_TLS12, 0xc02f, rsa_chain, rsa_key, rsa_root);
  if (rc != 0) { println("TLS 1.2 RSA failed at {rc}"); return 7; }
  rc = scenario(MTLS_TLS13, 0x1301, p384_chain, p384_key, p384_root);
  if (rc != 0) { println("TLS 1.3 P-384 failed at {rc}"); return 8; }
  rc = scenario(MTLS_TLS12, 0xc02b, p384_chain, p384_key, p384_root);
  if (rc != 0) { println("TLS 1.2 P-384 failed at {rc}"); return 9; }
  rc = edge_cases();
  if (rc != 0) { println("edge cases failed at {rc}"); return 5; }
  println("loopback ok");
  return 0;
}
