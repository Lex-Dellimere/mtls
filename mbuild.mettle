import "mbuild/api";

// mtls: TLS 1.3 and 1.2 for Mettle, in pure Mettle.
//
// Layout: src/mtls.mettle is the facade; modules sit in src/<area>/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
fn project() {
  mb_package("mtls", "0.2.0");
  mb_meta("description", "TLS 1.3 and 1.2 client and server in pure Mettle: X.509 validation, mutual TLS, ALPN, resumption, blocking, thread-shared and non-blocking (alph) I/O");
  mb_meta("license", "Apache-2.0");
  mb_import_root("src");
}

fn deps() {
  mb_dep_path("crypto", "../cryptex");
}

// interop: builds the release tools and runs tests/interop.sh, which needs
// `openssl` on the PATH (OpenSSL 3). With alph checked out next to mtls it
// also runs examples/alph_echo (TLS in alph actors) in debug and release.
fn cmd_interop(a: MbArgs*) -> int32 {
  if (mb_mbuild("build -r") != 0) { return 1; }
  if (mb_sh("sh tests/interop.sh build/" + mb_os() + "/release") != 0) { return 1; }
  return mb_sh("test -d ../alph || exit 0; cd examples/alph_echo && \"$MBUILD_EXE\" build && ./build/" + mb_os() + "/debug/mtls_alph_echo && \"$MBUILD_EXE\" build -r && ./build/" + mb_os() + "/release/mtls_alph_echo");
}

// fuzz: a long fuzz run in release (MTLS_FUZZ_ROUNDS, default 20000).
fn cmd_fuzz(a: MbArgs*) -> int32 {
  var rounds: string = "20000";
  if (mb_nargs(a) > 0) { rounds = mb_arg(a, 0); }
  if (mb_mbuild("test -r fuzz") != 0) { return 1; }
  return mb_sh("MTLS_FUZZ_ROUNDS=" + rounds + " .mbuild/test-bins/" + mb_os() + "/release/fuzz && MTLS_FUZZ_ROUNDS=" + rounds + " .mbuild/test-bins/" + mb_os() + "/release/x509_fuzz");
}
